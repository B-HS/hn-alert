{
    "name": "hn-digest",
    "type": "module",
    "scripts": {
        "dev": "bun --hot server.ts",
        "build": "bun run css:build && bun build entry.ts --outfile=api/index.js --target=node --format=esm --packages=bundle",
        "vercel-build": "bun scripts/vercel-build.ts",
        "css": "tailwindcss -i ./styles/input.css -o ./public/styles.css --watch",
        "css:build": "tailwindcss -i ./styles/input.css -o ./public/styles.css --minify",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "bun db/migrate.ts",
        "db:studio": "drizzle-kit studio"
    },
    "dependencies": {
        "@google/genai": "^1.40.0",
        "@hono/node-server": "^1.19.9",
        "@hono/react-renderer": "^1.0.1",
        "cheerio": "^1.2.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "drizzle-orm": "^0.45.1",
        "hono": "^4.11.8",
        "lucide-react": "^0.563.0",
        "mysql2": "^3.16.3",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "rehype-stringify": "^10.0.1",
        "remark-parse": "^11.0.0",
        "remark-rehype": "^11.1.2",
        "tailwind-merge": "^3.4.0",
        "unified": "^11.0.5"
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.1.18",
        "@tailwindcss/typography": "^0.5.19",
        "@types/node": "^20.11.17",
        "@types/react": "^19.2.13",
        "@types/react-dom": "^19.2.3",
        "autoprefixer": "^10.4.24",
        "drizzle-kit": "^0.31.8",
        "feconfig-bhs": "^1.0.7",
        "postcss": "^8.5.6",
        "tailwindcss": "^4.1.18",
        "tsup": "^8.5.1",
        "tsx": "^4.7.1",
        "typescript": "^5.8.3"
    }
}
