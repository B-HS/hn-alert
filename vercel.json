{
  "buildCommand": "bun run build:vercel",
  "framework": null,
  "functions": {
    "api/index.js": {
      "runtime": "@vercel/node@3"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/sync",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/daily",
      "schedule": "0 21 * * *"
    },
    {
      "path": "/api/cron/weekly",
      "schedule": "0 9 * * 0"
    },
    {
      "path": "/api/cron/monthly",
      "schedule": "0 8 28-31 * *"
    }
  ]
}